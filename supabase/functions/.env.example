# Copy to supabase/functions/.env for `supabase functions serve` (git-ignored).
# Production: `supabase secrets set --env-file supabase/functions/.env`

# Order of providers. There is no demo/mock mode: real analysis or none.
# ("mock" exists for E2E only and needs ENVIRONMENT=test below.)
LLM_PROVIDERS=gemini,groq

GEMINI_API_KEY=
# One model or several, tried in order. The free-tier daily limit is per model (20/day each,
# Nov 2026), so several models add up. Check which ones your project has in AI Studio.
# GEMINI_MODEL=gemini-3.6-flash,gemini-3.8-flash

GROQ_API_KEY=
# GROQ_MODEL=qwen/qwen3.8-27b

# The shared demo account cannot be deleted through the account page.
DEMO_EMAIL=demo@carbon-receipts.app

# E2E only (CI): enables the deterministic test provider LLM_PROVIDERS=mock. Never set in production.
# ENVIRONMENT=test
