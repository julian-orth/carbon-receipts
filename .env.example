# Public Supabase values (safe in the client – access is enforced by grants + RLS).
# Local: `supabase status` prints API_URL and PUBLISHABLE_KEY after `supabase start`.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Optional: public demo account (shows a "Demo ansehen" button on the login page).
# Local seed: demo@carbon-receipts.app / demo-carbon-receipts
VITE_DEMO_EMAIL=
VITE_DEMO_PASSWORD=
